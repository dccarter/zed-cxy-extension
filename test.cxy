// ============================================================================
// Tests
// ============================================================================

test "add function" {
    ok!(add(1, 2) == 3)
    ok!(add(-1, 1) == 0)
    ok!(add(0, 0) == 0)
}

test "multiply function" {
    ok!(multiply(3, 4) == 12)
    ok!(multiply(0, 100) == 0)
}

test "Point struct" {
    var p1 = Point(1.0, 2.0)
    var p2 = Point(3.0, 4.0)
    var p3 = p1 + p2
    ok!(p3.x == 4.0)
    ok!(p3.y == 6.0)
    ok!(p1 == Point(1.0, 2.0))
}

test "GenericContainer" {
    var c = GenericContainer[i32](42`i32)
    ok!(c.empty())
}

test "Vector usage" {
    var vec = Vector[i32]()
    vec.push(1)
    vec.push(2)
    vec.push(3)
    ok!(vec.size() == 3)
    ok!(vec.pop() == 3)
    ok!(vec.size() == 2)
}

test "exception handling" {
    var result = divide(10, 0) catch { return }
    var ok = divide(10, 2) catch 0
    ok!(ok == 5)
}

test {
    // anonymous test
    var x: i32 = 10
    var y: i32 = 20
    ok!(x + y == 30)
    var x: i32 = 42
    #const T = #(bool, string, String)
    #const Refs  = #`T as M, i => &M`
    #const Strs  = #`T as M, i => M, M.isString`
    #const Reverse = #`T as M, i => typeat!(T, T.membersCount - i)`
    #const isInt = x is #i32
    #const MyT   = #i32
}
