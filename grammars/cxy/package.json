{
  "name": "tree-sitter-cxy",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the Cxy programming language",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "parser",
    "lexer",
    "tree-sitter",
    "cxy",
    "syntax",
    "highlighting"
  ],
  "author": "Cxy Community",
  "license": "MIT",
  "dependencies": {
    "nan": "^2.17.0"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.20.8"
  },
  "peerDependencies": {
    "tree-sitter": "^0.20.0"
  },
  "tree-sitter": [
    {
      "scope": "source.cxy",
      "file-types": [
        "cxy"
      ]
    }
  ],
  "files": [
    "grammar.js",
    "src",
    "bindings",
    "queries"
  ],
  "scripts": {
    "build": "tree-sitter generate && node-gyp build",
    "test": "tree-sitter test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cxy-lang/tree-sitter-cxy.git"
  },
  "bugs": {
    "url": "https://github.com/cxy-lang/tree-sitter-cxy/issues"
  },
  "homepage": "https://github.com/cxy-lang/tree-sitter-cxy"
}
