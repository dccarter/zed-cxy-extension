{
  "name": "tree-sitter-cxy",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for the CXY programming language",
  "main": "grammar.js",
  "keywords": [
    "parser",
    "tree-sitter",
    "cxy"
  ],
  "author": "CXY Community",
  "license": "MIT",
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "build": "tree-sitter generate && tree-sitter build --wasm -o ../cxy.wasm",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse"
  },
  "tree-sitter": [
    {
      "scope": "source.cxy",
      "file-types": [
        "cxy"
      ]
    }
  ]
}
